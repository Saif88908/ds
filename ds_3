#include <stdio.h>

#define MAX 100

int stack[MAX];
int top = -1;
int visited[MAX];

// Insert a vertex into the stack
void push(int item) {
    if (top < MAX - 1) {
        stack[++top] = item;
    }
}

// Remove the top vertex from the stack
int pop() {
    return stack[top--];
}

// Check whether the stack is empty
int isEmpty() {
    return top == -1;
}

// Perform Depth-First Search
void DFS(int adj[MAX][MAX], int n, int start) {
    int i, current;

    // Mark all vertices as unvisited
    for (i = 0; i < n; i++) {
        visited[i] = 0;
    }

    top = -1;
    push(start);
    visited[start] = 1;

    printf("DFS Traversal starting from vertex %d: ", start);

    while (!isEmpty()) {
        current = pop();
        printf("%d ", current);

        // Visit adjacent unvisited vertices
        for (i = n - 1; i >= 0; i--) {
            if (adj[current][i] == 1 && !visited[i]) {
                push(i);
                visited[i] = 1;
            }
        }
    }

    printf("\n");
}

// Add an undirected edge
void addEdge(int graph[MAX][MAX], int start, int end) {
    graph[start][end] = 1;
    graph[end][start] = 1;
}

int main() {
    int vertices, edges, start, end, i;
    int adj[MAX][MAX] = {0};

    printf("Input the number of vertices: ");
    scanf("%d", &vertices);

    if (vertices < 1 || vertices > MAX) {
        printf("Invalid number of vertices.\n");
        return 1;
    }

    printf("Input the number of edges: ");
    scanf("%d", &edges);

    if (edges < 0 || edges > vertices * (vertices - 1) / 2) {
        printf("Invalid number of edges.\n");
        return 1;
    }

    // Read the edges of the graph
    for (i = 0; i < edges; i++) {
        printf("Input edge %d (start end): ", i + 1);
        scanf("%d %d", &start, &end);

        if (start < 0 || start >= vertices ||
            end < 0 || end >= vertices) {
            printf("Invalid edge. Try again.\n");
            i--;
            continue;
        }

        addEdge(adj, start, end);
    }

    // Read the starting vertex
    printf("Enter starting vertex (0 to %d): ", vertices - 1);
    scanf("%d", &start);

    if (start < 0 || start >= vertices) {
        printf("Invalid starting vertex.\n");
        return 1;
    }

    DFS(adj, vertices, start);

    return 0;
}
