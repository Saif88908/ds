#include <stdio.h>

#define SIZE 10

// Structure of the hash table
struct HashTable {
    int keys[SIZE];
    int occupied[SIZE];
};

// Initialize the hash table
void initialize(struct HashTable *table) {
    int i;

    for (i = 0; i < SIZE; i++) {
        table->keys[i] = -1;
        table->occupied[i] = 0;
    }
}

// Calculate the hash index
int hash(int key) {
    return key % SIZE;
}

// Insert a key using linear probing
void insert(struct HashTable *table, int key) {
    int index = hash(key);

    while (table->occupied[index]) {
        printf("Collision Occurred at index %d\n", index);

        // Move to the next index
        index = (index + 1) % SIZE;
    }

    table->keys[index] = key;
    table->occupied[index] = 1;

    printf("Inserted %d at index %d\n", key, index);
}

int main() {
    struct HashTable table;

    // Initialize the table
    initialize(&table);

    // Insert values into the hash table
    insert(&table, 10);
    insert(&table, 22);
    insert(&table, 34);
    insert(&table, 45);
    insert(&table, 20);

    return 0;
}
