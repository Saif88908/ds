#include <stdio.h>

#define MAX 100

int queue[MAX];
int front, rear;
int visited[MAX];

// Insert a vertex into the queue
void enqueue(int v) {
    if (rear == MAX - 1) {
        printf("Queue overflow\n");
        return;
    }

    if (front == -1) {
        front = 0;
    }

    queue[++rear] = v;
}

// Remove a vertex from the queue
int dequeue() {
    if (front == -1 || front > rear) {
        return -1;
    }

    return queue[front++];
}

// Perform Breadth-First Search
void BFS(int adj[MAX][MAX], int n, int start) {
    int i, current;

    front = rear = -1;

    // Mark all vertices as unvisited
    for (i = 0; i < n; i++) {
        visited[i] = 0;
    }

    // Start traversal from the given vertex
    enqueue(start);
    visited[start] = 1;

    printf("BFS Traversal starting from vertex %d: ", start);

    while (front != -1 && front <= rear) {
        current = dequeue();
        printf("%d ", current);

        // Visit all adjacent unvisited vertices
        for (i = 0; i < n; i++) {
            if (adj[current][i] == 1 && !visited[i]) {
                visited[i] = 1;
                enqueue(i);
            }
        }
    }

    printf("\n");
}

int main() {
    int n, i, j, start;
    int adj[MAX][MAX];

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    if (n < 1 || n > MAX) {
        printf("Invalid number of vertices.\n");
        return 1;
    }

    // Read the adjacency matrix
    printf("Enter adjacency matrix of the graph:\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &adj[i][j]);

            if (adj[i][j] != 0 && adj[i][j] != 1) {
                printf("Invalid adjacency matrix.\n");
                return 1;
            }
        }
    }

    // Read the starting vertex
    printf("Enter starting vertex (0 to %d): ", n - 1);
    scanf("%d", &start);

    if (start < 0 || start >= n) {
        printf("Invalid starting vertex.\n");
        return 1;
    }

    BFS(adj, n, start);

    return 0;
}
